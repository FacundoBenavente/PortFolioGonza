---
import Collage from '../Collage.astro';
import type { CollageItem } from '../collage';

const navLinks = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Disciplinas', href: '#disciplinas' },
  { label: 'Trayectoria', href: '#trayectoria' },
];

// Lienzo del collage en Figma: 783 × 445 (desde x 597, y 364 del frame)
const collage: CollageItem[] = [
  {
    kind: 'photo',
    src: '/images/hero-dashboard.jpg',
    alt: 'Monitor con un tablero de métricas: gráficos de barras y curvas de rendimiento',
    left: 16.264,
    top: 2.575,
    width: 77.267,
    height: 71.236,
    rotate: -2,
    // Recorte de Figma: imagen al 119% × 140%, corrida hacia abajo
    recorte: { x: -0.0525, y: -0.3984, w: 1.1942, h: 1.3984 },
  },
  {
    kind: 'photo',
    src: '/images/hero-hologramas.png',
    alt: 'Manos sobre un teclado frente a interfaces holográficas',
    left: 1.011,
    top: 44.89,
    width: 43.55,
    height: 52.809,
    rotate: 3,
  },
  {
    kind: 'chip',
    text: 'DATOS → DECISIONES',
    cx: 59.825,
    cy: 73.951,
    rotate: -2,
    color: 'teal',
    widthPx: 262,
    heightPx: 57,
    fontPx: 20,
    weight: 600,
  },
  { kind: 'note', text: 'observar antes de asumir_', left: 48.531, top: 86.742, fontPx: 10 },
];
---

<header class="bg-night">
  <div class="container-page flex flex-col">
    <!-- Navegación principal -->
    <nav
      class="flex h-20 items-center justify-between gap-6 border-b border-line lg:h-24"
      aria-label="Navegación principal"
    >
      <a href="#top" class="text-lg font-bold whitespace-nowrap md:text-xl">Gonzalo Rey Balmaceda</a>
      <div class="flex items-center gap-8">
        <ul class="hidden items-center gap-8 md:flex">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-mist transition-colors hover:text-snow">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="#contacto"
          class="flex h-[42px] items-center border border-pink bg-surface px-5 text-xs whitespace-nowrap text-pink transition-colors hover:bg-pink hover:text-night"
        >
          Contacto
        </a>
      </div>
    </nav>

    <!-- Ficha de apertura -->
    <p class="label pt-8 pb-3.5 text-mist">PORTFOLIO PERSONAL / PERFIL EN FORMACIÓN</p>

    <h1 class="text-[clamp(52px,11.5vw,166px)] leading-none font-bold text-teal">CURIOSIDAD</h1>

    <!-- Introducción y collage -->
    <div class="flex flex-col gap-11 pt-8 pb-10 lg:flex-row lg:items-start lg:pb-[11px]">
      <div class="flex flex-col gap-6 pt-3 lg:w-[485px] lg:shrink-0">
        <p class="text-[clamp(36px,4vw,52px)] leading-[1.02]">
          Entre la <span class="text-teal">lógica</span> y la <span class="text-pink">imaginación</span>.
        </p>
        <p class="max-w-[430px] text-lg leading-[1.5]">
          Soy Gonzalo. Estoy construyendo un camino entre los datos, el diseño y la programación. Me
          interesa entender cómo funcionan las cosas y explorar cómo podrían ser.
        </p>
        <div class="flex flex-wrap items-center gap-6 pt-1">
          <a
            href="#proyectos"
            class="flex h-12 items-center border border-teal bg-surface px-6 text-xs font-bold text-teal transition-colors hover:bg-teal hover:text-night"
          >
            EXPLORAR PROYECTOS ↓
          </a>
          <p class="label text-mist">SIEMPRE APRENDIENDO</p>
        </div>
      </div>

      <Collage width={783} height={445} items={collage} class="lg:flex-1" />
    </div>

    <!-- Cierre de presentación -->
    <div
      class="flex min-h-[74px] flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line py-4 text-[11px] text-mist"
    >
      <p class="label">ANÁLISIS DE DATOS / DISEÑO UX/UI / 3D / FRONT-END</p>
      <a href="#sobre-mi" class="transition-colors hover:text-snow">DESLIZÁ PARA CONOCERME ↓</a>
    </div>
  </div>
</header>
