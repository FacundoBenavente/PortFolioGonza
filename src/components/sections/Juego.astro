---
import SectionIndex from '../SectionIndex.astro';
import Collage from '../Collage.astro';
import type { CollageItem } from '../collage';
import Flecha from '../Flecha.astro';

// Lienzo del collage en Figma: 668 × 503 (desde x 700, y 3829 del frame)
const collage: CollageItem[] = [
  {
    kind: 'photo',
    src: '/images/juego-ecuaciones.jpg',
    alt: 'Pizarrón negro lleno de ecuaciones y figuras geométricas',
    left: 5.269,
    top: 2.095,
    width: 61.377,
    height: 56.859,
    rotate: -3,
  },
  {
    kind: 'photo',
    src: '/images/juego-videojuegos.png',
    alt: 'Personas jugando con una consola portátil en un evento',
    left: 29.32,
    top: 43.457,
    width: 61.677,
    height: 54.274,
    rotate: 3,
  },
  {
    kind: 'chip',
    text: 'MATEMÁTICA + NÚMEROS + JUEGOS',
    cx: 24.844,
    cy: 58.956,
    rotate: -8,
    color: 'pink',
    widthPx: 312,
    heightPx: 50,
    fontPx: 15,
    weight: 700,
  },
];
---

<section class="bg-surface">
  <div class="container-page flex flex-col gap-9 pt-16 pb-12">
    <SectionIndex number="05" label="VIDEOJUEGOS / JUGAR" />

    <div class="flex flex-col gap-14 lg:flex-row lg:items-start lg:gap-14">
      <!-- Pensamiento y juego -->
      <div class="flex flex-col gap-[30px] lg:w-[580px] lg:shrink-0">
        <h2 class="text-[clamp(44px,4.5vw,64px)] leading-[0.98] font-bold">
          JUGAR TAMBIÉN<br />ES <span class="text-teal">RESOLVER.</span>
        </h2>
        <p class="max-w-[520px] text-lg leading-[1.5]">
          Una olimpiada y una partida no son lo mismo. Pero ambas me invitan a leer las reglas,
          reconocer patrones, pensar una estrategia y aprender de cada intento.
        </p>
        <div class="flex flex-col gap-8 sm:flex-row">
          <div class="flex flex-col gap-2.5 sm:w-[258px] sm:shrink-0">
            <p class="text-[clamp(44px,4.2vw,58px)] whitespace-nowrap text-pink">3 finales</p>
            <p class="leading-[1.5]">Participante de 3 finales nacionales de olimpiadas de matemática.</p>
            <p class="label text-mist">2019 / 2021 / 2024</p>
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-2.5">
            <p class="text-[clamp(44px,4.2vw,58px)] whitespace-nowrap text-teal">+4000 h</p>
            <p class="leading-[1.5]">Jugando videojuegos.</p>
          </div>
        </div>
      </div>

      <Collage width={668} height={503} items={collage} class="lg:-mt-3 lg:flex-1" />
    </div>

    <!-- Cierre personal -->
    <div
      class="flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line pt-6 text-[11px] text-mist"
    >
      <p class="label">precisión / estrategia / juego / pausa</p>
      <p>A VECES, LA MEJOR IDEA LLEGA JUGANDO <Flecha direccion="diagonal" /></p>
    </div>
  </div>
</section>
