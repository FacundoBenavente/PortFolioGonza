---
import SectionIndex from '../SectionIndex.astro';
import Collage from '../Collage.astro';
import type { CollageItem } from '../collage';

// Lienzo del collage en Figma: 668 × 492
const collage: CollageItem[] = [
  {
    kind: 'photo',
    src: '/images/juego-ecuaciones.jpg',
    alt: 'Pizarrón negro lleno de ecuaciones y figuras geométricas',
    left: 4.072,
    top: 3.767,
    width: 61.377,
    height: 58.13,
    rotate: -3,
  },
  {
    kind: 'photo',
    src: '/images/juego-videojuegos.png',
    alt: 'Personas jugando con una consola portátil en un evento',
    left: 28.123,
    top: 46.056,
    width: 61.677,
    height: 55.488,
    rotate: 3,
  },
  { kind: 'tape', left: 20.894, top: 0.36, width: 15.269, height: 4.675, rotate: 2 },
  {
    kind: 'chip',
    text: 'MATEMÁTICA + NÚMEROS + JUEGOS',
    cx: 22.63,
    cy: 61.903,
    rotate: -8,
    color: 'magenta',
    fontPx: 15,
    padXPx: 18,
    padYPx: 16,
  },
];
---

<section class="bg-stone">
  <div class="container-page flex flex-col gap-9 pt-16 pb-12">
    <SectionIndex number="05" label="FUERA DEL CÓDIGO / DENTRO DEL JUEGO" />

    <div class="flex flex-col gap-14 lg:flex-row lg:items-start lg:gap-16">
      <!-- Pensamiento y juego -->
      <div class="flex flex-col gap-[30px] lg:w-[580px] lg:shrink-0">
        <h2 class="text-[clamp(44px,5vw,70px)] leading-[0.98] font-bold">
          JUGAR TAMBIÉN<br />ES RESOLVER.
        </h2>
        <p class="max-w-[520px] text-lg leading-[1.5] text-muted">
          Una olimpiada y una partida no son lo mismo. Pero ambas me invitan a leer las reglas,
          reconocer patrones, pensar una estrategia y aprender de cada intento.
        </p>
        <div class="flex flex-col gap-8 sm:flex-row">
          <div class="flex flex-col gap-2.5 sm:w-[258px] sm:shrink-0">
            <p class="text-[clamp(44px,4.2vw,58px)] whitespace-nowrap">3 finales</p>
            <p class="leading-[1.5]">Participante de 3 finales de olimpiadas de matemática.</p>
            <p class="label text-muted">2019 / 2020 / 2024</p>
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-2.5">
            <p class="text-[clamp(44px,4.2vw,58px)] whitespace-nowrap">+4000 h</p>
            <p class="leading-[1.5]">
              Jugando videojuegos.<br />
              Estrategia, exploración y pausa.
            </p>
            <p class="label text-muted">PLAY / THINK / REPEAT</p>
          </div>
        </div>
      </div>

      <Collage width={668} height={492} items={collage} class="lg:flex-1" />
    </div>

    <!-- Cierre personal -->
    <div
      class="flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line pt-6 font-mono text-[11px]"
    >
      <p class="leading-[1.5] text-muted">precisión / estrategia / juego / pausa</p>
      <p>A VECES, LA MEJOR IDEA LLEGA JUGANDO ↗</p>
    </div>
  </div>
</section>
