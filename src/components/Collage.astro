---
/**
 * Collage de recortes (fotos con marco y etiquetas) del diseño.
 * Todas las posiciones y tamaños se expresan en porcentaje del lienzo original
 * de Figma, y los textos en unidades de contenedor (cqw), así el collage
 * escala proporcionalmente en cualquier ancho.
 */
import type { CollageItem } from './collage';
import Flecha from './Flecha.astro';

interface Props {
  /** Ancho y alto del lienzo en Figma */
  width: number;
  height: number;
  items: CollageItem[];
  class?: string;
}

const { width, height, items, class: className } = Astro.props;

/** px del diseño → unidades de contenedor */
const cq = (px: number) => `${((px / width) * 100).toFixed(3)}cqw`;
const pct = (n: number) => `${n}%`;
const photoPad = cq(8);
---

<div
  class:list={['relative w-full [container-type:inline-size]', className]}
  style={{ aspectRatio: `${width} / ${height}` }}
>
  {
    items.map((item) => {
      if (item.kind === 'photo') {
        return (
          <div
            class="absolute flex bg-surface shadow-photo"
            style={{
              left: pct(item.left),
              top: pct(item.top),
              width: pct(item.width),
              height: pct(item.height),
              padding: photoPad,
              rotate: `${item.rotate}deg`,
            }}
          >
            <div class="relative size-full overflow-hidden">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class:list={['absolute max-w-none', !item.recorte && 'inset-0 size-full object-cover']}
                style={
                  item.recorte && {
                    left: pct(item.recorte.x * 100),
                    top: pct(item.recorte.y * 100),
                    width: pct(item.recorte.w * 100),
                    height: pct(item.recorte.h * 100),
                  }
                }
              />
            </div>
          </div>
        );
      }
      if (item.kind === 'chip') {
        return (
          <p
            class:list={[
              'absolute flex items-center justify-center border bg-surface whitespace-nowrap',
              item.color === 'teal' ? 'border-teal text-teal' : 'border-pink text-pink',
            ]}
            style={{
              left: pct(item.cx),
              top: pct(item.cy),
              width: cq(item.widthPx),
              height: cq(item.heightPx),
              translate: '-50% -50%',
              rotate: `${item.rotate}deg`,
              fontSize: cq(item.fontPx),
              fontWeight: item.weight,
            }}
          >
            {item.text.split(' → ').map((parte, i) => (i ? [<Flecha direccion="derecha" grosor={2.6} class="mx-[0.3em]" />, parte] : parte))}
          </p>
        );
      }
      return (
        <p
          class="absolute whitespace-nowrap text-mist"
          style={{
            left: pct(item.left),
            top: pct(item.top),
            fontSize: `max(9px, ${cq(item.fontPx)})`,
          }}
        >
          {item.text}
        </p>
      );
    })
  }
</div>
