---
/** Índice de sección: "01 ─── SOBRE MÍ" (número y línea en teal, etiqueta en mist). */
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class="text-[11px] text-teal">{number}</span>
  <span class="h-[3px] w-8 bg-teal" aria-hidden="true"></span>
  <span class="label text-mist">{label}</span>
</div>
